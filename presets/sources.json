          "file": "references/breeze/minimax-calm.wav",
          "sha256": "af7cc7ff5324e5b5db4af371ee4e3a23fba5080575dd36add85e3bd0c558af84",
          "bytes": 688422,
          "text": "神之眼啊那可是导引元素力所必要的装置呢唯独在你身上却是例外究竟是什么原理有了你有空陪姐姐做个实验吗",
          "language": "zh",
          "durationMs": 14341,
          "method": "full-authorized-original"
        },
        "chatgpt": {
