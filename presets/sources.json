        },
        "grok": {
          "sourceSHA": "1387e15bf8cb599b8c12aef7737149df22ebfc33900d5fc7c8667df4346d2334",
          "file": "references/breeze/grok-calm.wav",
          "sha256": "1387e15bf8cb599b8c12aef7737149df22ebfc33900d5fc7c8667df4346d2334",
          "bytes": 684662,
          "text": "英雄形态的宵宫姐姐登场邪恶退散正义必胜就这么和小孩子们介绍你教给我的新力量没问题吧应该很帅吧哈哈如果有人欺负你也要告诉我哦",
          "language": "zh",
          "durationMs": 14263,
          "method": "full-authorized-original"
        },
        "seed": {
          "sourceSHA": "2b21b9c2b878162096875ea6add714caa6723202dbf98d2c91a22b1dc7f181d8",
          "file": "references/breeze/seed-calm.wav",
          "sha256": "2b21b9c2b878162096875ea6add714caa6723202dbf98d2c91a22b1dc7f181d8",
          "bytes": 738578,
          "text": "调酒师可是很忙的即使不在酒馆工作也要抽出时间来收集配方所以所以没有要紧事情的话就不要来打搅我猫尾酒馆的招牌调酒师",
          "language": "zh",
          "durationMs": 15386,
          "method": "full-authorized-original"
        },
        "kimi": {
          "sourceSHA": "1c34dce6285284f105ee86cf5b9c15a7593250443e7d5507066bbef55c78494e",
          "file": "references/breeze/kimi-calm.wav",
          "sha256": "1c34dce6285284f105ee86cf5b9c15a7593250443e7d5507066bbef55c78494e",
          "bytes": 634506,
          "text": "这么早没有必要的工作时我习惯中午起床啊有点困了小睡一会吧不用提醒我到了工作时间我自然会醒的",
          "language": "zh",
          "durationMs": 13218,
          "method": "full-authorized-original"
        },
        "qwen": {
          "sourceSHA": "c116003389917914d01c81bd18815f1f0216b181a5aaac1a45b81fc413f57d85",
