          "file": "references/breeze/gemini-calm.wav",
          "sha256": "3b51ab677546c2491f7ff02eaecc28412165225e16561daf7e8861226a8188c4",
          "bytes": 734816,
          "text": "神之眼是神对我的认可吧我要成为最优秀的侦察骑士才行我可不会认输有种不安的感觉刚才是凯亚陪着你吧他没给你添麻烦吧大多数时候都待在自己的工坊里",
          "language": "zh",
          "durationMs": 15308,
          "method": "full-authorized-original"
        },
